# ---------- Application ----------
APP_ENV=production
APP_URL=https://w5d.tech
APP_BASE_PATH=
APP_LANG=en
# Obfuscated owner-portal mount path (no slashes)
ADMIN_URL_PATH=panel-x9z

# ---------- Webmaster (generate hash: php -r "echo password_hash('YourStrongPassword', PASSWORD_ARGON2ID), PHP_EOL;") ----------
WEBMASTER_USERNAME=owner
WEBMASTER_PASSWORD_HASH=

# ---------- Database (SQLite is the default and the only driver supported on the 100 MB VPS) ----------
DB_DRIVER=sqlite
DB_PATH=storage/w5d.sqlite
# DB_DRIVER=mysql
# DB_HOST=db.provider.example
# DB_PORT=3306
# DB_DATABASE=w5d
# DB_USERNAME=w5d
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# ---------- Storage doctrine (100 MB VPS) ----------
STORAGE_DRIVER=null        # null | local | s3
ARCHIVE_DRIVER=prune       # prune | local | external
BACKUP_DRIVER=external     # external | local
UPLOAD_MAX_MB=2

# ---------- Progressive pricing (published constants; every change must be dated + logged) ----------
PRICING_ALPHA=1.0
PRICING_BETA=1.0
PRICING_P_PROG=2.0
PRICING_P_TIME=2.0
PRICING_CAP=3.0

# ---------- Payments ----------
# demo = no money moves, orders are recorded as 'demo'. Switch only after counsel + PSP contract.
PAYMENT_MODE=demo

# ---------- Mail / SMS (interface only; stub adapters by default) ----------
SMS_DRIVER=stub
CONTACT_EMAIL=owner@w5d.tech

# ---------- View cache (Laravel-style compiled Blade views in storage/framework/views) ----------
VIEW_CACHE=true            # false = never write compiled views to disk
VIEW_CACHE_CHECK=          # empty = auto (check source mtime when APP_ENV != production); false = trust cache, run `php bin/view.php cache` on deploy

# ---------- SMTP / mail (MAIL_DRIVER: log = write to storage/logs, nothing is sent | smtp | mail = PHP mail()) ----------
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls        # tls (STARTTLS, 587) | ssl (465) | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@w5d.tech
MAIL_FROM_NAME=W5D
MAIL_REPLY_TO=owner@w5d.tech
MAIL_FOOTER_ADDRESS=Tunisia   # postal/company line shown in every e-mail footer

# ---------- Payment: D17 (Tunisia only; manual admin verification) ----------
PAYMENT_D17_ENABLED=false
PAYMENT_D17_GSM=+216XXXXXXXX     # the D17 wallet number customers send money to
PAYMENT_D17_NAME=W5D TECH        # account holder name shown to the payer
PAYMENT_D17_NOTE=                # optional extra instruction

# ---------- Social share + SEO ----------
SOCIAL_SHARE_ENABLED=true
SOCIAL_SHARE_NETWORKS=native,copy,whatsapp,facebook,x,linkedin,telegram,reddit,email
SOCIAL_SHARE_HASHTAGS=W5D,Tunisia
SOCIAL_SHARE_VIA=w5d_tech        # X/Twitter handle without @ (twitter:site + share "via")
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_DEFAULT_IMAGE=og-default.jpg
SOCIAL_PROFILE_FACEBOOK=
SOCIAL_PROFILE_X=
SOCIAL_PROFILE_LINKEDIN=
SOCIAL_PROFILE_GITHUB=
SOCIAL_PROFILE_INSTAGRAM=
SOCIAL_PROFILE_YOUTUBE=
SEO_ORG_NAME=W5D TECH
SEO_ORG_EMAIL=owner@w5d.tech

# ---------- Accounts ----------
AUTH_REMEMBER_DAYS=30
AUTH_REQUIRE_VERIFIED=true       # login only after e-mail verification
# Social login (OAuth 2.0 authorization-code flow). A provider appears only when its client id is set.
# Callback URL to register at each provider: {APP_URL}/account/social/{provider}/callback/
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=

# ---------- Platform ----------
# DB_AUTO_MIGRATE=true   # apply db/migrations/*.sql automatically on first DB use (default true)
# APP_KEY=               # HMAC key for signed links (unsubscribe, D17 pay links). Empty = storage/app.key is generated
